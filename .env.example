# Firebase Web SDK (safe to expose through VITE_; restrict the Firebase API key
# in the Firebase console by domain before deploying).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Set true only for local offline mock flow. Hosted environments must leave false.
VITE_DEMO_MODE=false

# Neon PostgreSQL server-only connection string. Never prefix with VITE_.
DATABASE_URL=

# Firebase Admin server-only credentials. Store as Vercel encrypted variables.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

CRON_SECRET=
PAYMENT_PROVIDER=mock
TAYPI_PUBLIC_KEY=
TAYPI_SECRET_KEY=
TAYPI_WEBHOOK_SECRET=
# Leave empty to auto-select sandbox for taypi_pk_test_* and production for taypi_pk_live_*.
TAYPI_API_URL=
TAYPI_SANDBOX=false
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
CULQI_PUBLIC_KEY=
CULQI_SECRET_KEY=
CULQI_WEBHOOK_SECRET=
